# Copy to .env and fill in. Only GEMINI_API_KEY is required.
# Values set here take precedence over the surrounding shell environment.
GEMINI_API_KEY=your-google-ai-studio-key-here

# Everything below is optional. The defaults in config.py are used when unset.
# EXTRACTION_MODEL=gemini-2.5-flash
# ADJUDICATION_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768

# DB_PATH=data/knowledge.duckdb
# TRACE_PATH=data/traces.jsonl

# Set to 0 to run the deterministic pipeline with no network calls at all.
# LLM_ENABLED=1

# Candidate funnel and rule engine tuning.
# NEIGHBOUR_TOP_K=12
# NEIGHBOUR_COSINE_THRESHOLD=0.80
# MATERIAL_GAP_RELATIVE=0.02
